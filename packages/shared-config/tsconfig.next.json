{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "SAP-ONAC Next.js",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@sap-onac/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@sap-onac/shared-schemas": ["../../packages/shared-schemas/src/index.ts"]
    }
  }
}
