# Variables de entorno raíz para SAP-ONAC (no usar en producción)
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

DATABASE_URL="mysql://root:sap_onac_dev@localhost:3306/sap_onac_dev"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=replace-with-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret-32-chars
JWT_REFRESH_EXPIRATION=7d

TWOFA_ISSUER=SAP-ONAC

BCRYPT_ROUNDS=12
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_EXPIRATION_DAYS=90

UPLOAD_DIR=/tmp/sap-onac-uploads
MAX_FILE_SIZE_MB=5

LOG_LEVEL=debug

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=SAP-ONAC
