// SAP-ONAC — Prisma Schema (Fase 1)
// Motor: MySQL 8.0 / MariaDB 10.11+

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================
// Enums
// =====================================================

enum PensionerState {
  active
  inactive
  deceased
  reincorporated_sma
}

enum MovementType {
  alta
  baja
  reincorporacion_sma
}

enum NeedPriority {
  low
  medium
  high
}

enum NeedStatus {
  pending
  in_progress
  resolved
  cancelled
}

enum AuditAction {
  create
  update
  delete
  export
  login
  logout
  failed_login
  view_sensitive
}

// =====================================================
// Usuario y seguridad
// =====================================================

model User {
  id                   String    @id @default(uuid())
  uuid                 String    @unique @db.Char(36)
  username             String    @unique @db.VarChar(50)
  email                String?   @unique @db.VarChar(150)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt    DateTime? @map("password_changed_at")
  passwordExpiresAt    DateTime? @map("password_expires_at")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedAt             DateTime? @map("locked_at")
  isActive             Boolean   @default(true) @map("is_active")
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret") @db.VarChar(255)
  lastLoginAt          DateTime? @map("last_login_at")
  lastLoginIp          String?   @map("last_login_ip") @db.VarChar(45)
  fullName             String    @map("full_name") @db.VarChar(255)
  position             String?   @db.VarChar(150)
  forcePasswordChange  Boolean   @default(false) @map("force_password_change")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  userRoles       UserRole[]
  userTerritories UserTerritory[]
  sessions        Session[]
  auditLogs       AuditLog[]

  @@map("user")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  userTerritories UserTerritory[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(150)
  description String? @db.Text
  module      String? @db.VarChar(50)

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           BigInt @id @default(autoincrement())
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id           BigInt   @id @default(autoincrement())
  userId       String   @map("user_id")
  roleId       BigInt   @map("role_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  isActive     Boolean  @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_role")
}

model UserTerritory {
  id             BigInt  @id @default(autoincrement())
  userId         String  @map("user_id")
  roleId         BigInt  @map("role_id")
  provinceId     BigInt? @map("province_id")
  municipalityId BigInt? @map("municipality_id")
  assignedAt     DateTime @default(now()) @map("assigned_at")

  user         User             @relation(fields: [userId], references: [id])
  role         Role             @relation(fields: [roleId], references: [id])
  province     CatProvince?     @relation(fields: [provinceId], references: [id])
  municipality CatMunicipality? @relation(fields: [municipalityId], references: [id])

  @@map("user_territory")
}

model Session {
  id                BigInt   @id @default(autoincrement())
  userId            String   @map("user_id")
  refreshTokenHash  String   @unique @map("refresh_token_hash") @db.Char(64)
  deviceInfo        String?  @map("device_info") @db.VarChar(500)
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  issuedAt          DateTime @default(now()) @map("issued_at")
  expiresAt         DateTime @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  isActive          Boolean  @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isActive], map: "idx_session_user_active")
  @@map("session")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  uuid           String   @unique @db.Char(36)
  userId         String?  @map("user_id")
  action         AuditAction
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       BigInt?  @map("entity_id")
  entityUuid     String?  @map("entity_uuid") @db.Char(36)
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  ipAddress      String   @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  occurredAt     DateTime @default(now()) @map("occurred_at")
  recordHash     String   @map("record_hash") @db.Char(64)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt], map: "idx_audit_user_date")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([action, occurredAt], map: "idx_audit_action_date")
  @@map("audit_log")
}

// =====================================================
// Pensionado y dependencias
// =====================================================

model Pensioner {
  id                       BigInt        @id @default(autoincrement())
  uuid                     String        @unique @db.Char(36)
  consecutiveNumber        Int           @map("consecutive_number")
  identityCard             String        @unique @map("identity_card") @db.Char(11)
  certificateSerial        String?       @map("certificate_serial") @db.VarChar(50)
  firstName                String        @map("first_name") @db.VarChar(100)
  lastName1                String        @map("last_name_1") @db.VarChar(100)
  lastName2                String?       @map("last_name_2") @db.VarChar(100)
  knownAs                  String?       @map("known_as") @db.VarChar(150)
  address                  String?       @db.VarChar(500)
  provinceId               BigInt        @map("province_id")
  municipalityId           BigInt        @map("municipality_id")
  sexId                    BigInt?       @map("sex_id")
  skinColorId              BigInt?       @map("skin_color_id")
  healthStatusId           BigInt?       @map("health_status_id")
  categoryId               BigInt?       @map("category_id")
  civilStatusId            BigInt?       @map("civil_status_id")
  laborLinkId              BigInt?       @map("labor_link_id")
  salary                   Decimal?      @db.Decimal(12, 2)
  aep                      Boolean?      @default(false)
  pmtAmount                Decimal?      @map("pmt_amount") @db.Decimal(12, 2)
  pensionTypeId            BigInt?       @map("pension_type_id")
  grantedBy                String?       @map("granted_by") @db.VarChar(150)
  socialSecurityPension    Decimal?      @map("social_security_pension") @db.Decimal(12, 2)
  bankControlNumber        String?       @map("bank_control_number") @db.VarChar(20)
  housingTypeId            BigInt?       @map("housing_type_id")
  propertyTypeId           BigInt?       @map("property_type_id")
  currentState             PensionerState @map("current_state") @default(active)
  deceasedAt               DateTime?     @map("deceased_at")
  recordHash               String?       @map("record_hash") @db.Char(64)
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  deletedAt                DateTime?     @map("deleted_at")
  version                  Int           @default(1)

  province         CatProvince           @relation(fields: [provinceId], references: [id])
  municipality     CatMunicipality       @relation(fields: [municipalityId], references: [id])
  sex              CatSex?               @relation(fields: [sexId], references: [id])
  skinColor        CatSkinColor?         @relation(fields: [skinColorId], references: [id])
  healthStatus     CatHealthStatus?      @relation(fields: [healthStatusId], references: [id])
  category         CatPensionerCategory? @relation(fields: [categoryId], references: [id])
  civilStatus      CatCivilStatus?       @relation(fields: [civilStatusId], references: [id])
  laborLink        CatLaborLink?         @relation(fields: [laborLinkId], references: [id])
  pensionType      CatPensionType?       @relation(fields: [pensionTypeId], references: [id])
  housingType      CatHousingType?       @relation(fields: [housingTypeId], references: [id])
  propertyType     CatPropertyType?      @relation(fields: [propertyTypeId], references: [id])

  movements   Movement[]
  deathRecord DeathRecord?
  needs       Need[]

  @@index([provinceId, municipalityId], map: "idx_pensioner_province_municipality")
  @@index([categoryId], map: "idx_pensioner_category")
  @@index([currentState], map: "idx_pensioner_state")
  @@map("pensioner")
}

model Movement {
  id               BigInt       @id @default(autoincrement())
  uuid             String       @unique @db.Char(36)
  pensionerId      BigInt       @map("pensioner_id")
  movementType     MovementType @map("movement_type")
  movementDate     DateTime     @map("movement_date") @db.Date
  causeId          BigInt?      @map("cause_id")
  causeDescription String?      @map("cause_description") @db.VarChar(255)
  agreementNumber  String?      @map("agreement_number") @db.VarChar(50)
  agreementDate    DateTime?    @map("agreement_date") @db.Date
  notes            String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  pensioner Pensioner         @relation(fields: [pensionerId], references: [id])
  cause     CatMovementCause? @relation(fields: [causeId], references: [id])

  @@index([pensionerId, movementDate], map: "idx_movement_pensioner_date")
  @@map("movement")
}

model DeathRecord {
  id               BigInt   @id @default(autoincrement())
  pensionerId      BigInt   @unique @map("pensioner_id")
  deathDate        DateTime @map("death_date") @db.Date
  deathTime        DateTime? @map("death_time") @db.Time
  deathPlace       String?  @map("death_place") @db.VarChar(255)
  deathCause       String?  @map("death_cause") @db.VarChar(500)
  certificateTomo  String?  @map("certificate_tomo") @db.VarChar(20)
  certificateFolio String?  @map("certificate_folio") @db.VarChar(20)
  certificateDate  DateTime? @map("certificate_date") @db.Date
  certificateTime  DateTime? @map("certificate_time") @db.Time
  isKilledInAction Boolean  @default(false) @map("is_killed_in_action")
  recordHash       String?  @map("record_hash") @db.Char(64)

  pensioner Pensioner @relation(fields: [pensionerId], references: [id])

  @@map("death_record")
}

model Need {
  id                      BigInt      @id @default(autoincrement())
  uuid                    String      @unique @db.Char(36)
  pensionerId             BigInt      @map("pensioner_id")
  needTypeId              BigInt      @map("need_type_id")
  description             String      @db.Text
  priority                NeedPriority @default(medium)
  status                  NeedStatus  @default(pending)
  assignedToId            String?     @map("assigned_to_id")
  identifiedAt            DateTime    @map("identified_at") @db.Date
  targetDate              DateTime?   @map("target_date") @db.Date
  resolvedAt              DateTime?   @map("resolved_at")
  resolutionJustification String?     @map("resolution_justification") @db.Text
  solutionType            String?     @map("solution_type") @db.VarChar(100)
  previousNeedId          BigInt?     @map("previous_need_id")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  pensioner Pensioner @relation(fields: [pensionerId], references: [id])

  @@index([pensionerId], map: "idx_need_pensioner")
  @@index([status, priority], map: "idx_need_status_priority")
  @@map("need")
}

// =====================================================
// Nomencladores (cat_*)
// =====================================================

model CatProvince {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  municipalities  CatMunicipality[]
  pensioners      Pensioner[]
  userTerritories UserTerritory[]

  @@map("cat_province")
}

model CatMunicipality {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  provinceId  BigInt   @map("province_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  province        CatProvince       @relation(fields: [provinceId], references: [id])
  pensioners      Pensioner[]
  userTerritories UserTerritory[]

  @@index([provinceId], map: "idx_municipality_province")
  @@map("cat_municipality")
}

model CatSex {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pensioners Pensioner[]

  @@map("cat_sex")
}

model CatSkinColor {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pensioners Pensioner[]

  @@map("cat_skin_color")
}

model CatHealthStatus {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pensioners Pensioner[]

  @@map("cat_health_status")
}

model CatPensionerCategory {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pensioners Pensioner[]

  @@map("cat_pensioner_category")
}

model CatCivilStatus {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pensioners Pensioner[]

  @@map("cat_civil_status")
}

model CatLaborLink {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pensioners Pensioner[]

  @@map("cat_labor_link")
}

model CatPensionType {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pensioners Pensioner[]

  @@map("cat_pension_type")
}

model CatHousingType {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pensioners Pensioner[]

  @@map("cat_housing_type")
}

model CatPropertyType {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pensioners Pensioner[]

  @@map("cat_property_type")
}

model CatMovementCause {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique @db.VarChar(20)
  name       String   @db.VarChar(255)
  description String? @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  appliesTo  String  @map("applies_to") @db.VarChar(30) // 'alta' | 'baja' | 'reincorporacion_sma'
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  movements Movement[]

  @@index([appliesTo], map: "idx_movement_cause_applies_to")
  @@map("cat_movement_cause")
}
