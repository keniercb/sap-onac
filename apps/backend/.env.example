# ============================================================
# SAP-ONAC Backend — Variables de entorno
# ============================================================
# Copia este archivo a .env y ajusta los valores según tu entorno:
#   copy apps\backend\.env.example apps\backend\.env
# ============================================================

# Entorno de ejecución: development | test | production
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# ----- Base de datos MySQL -----
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Si usas Docker Compose (infra/docker/docker-compose.dev.yml):
#   - Usuario: root, Password: sap_onac_dev, Database: sap_onac_dev
DATABASE_URL=mysql://root:sap_onac_dev@localhost:3306/sap_onac_dev

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- JWT (cambia los secrets en producción) -----
# Mínimo 32 caracteres. Usa valores aleatorios diferentes para access y refresh.
JWT_ACCESS_SECRET=cambia-esto-en-produccion-access-secret-32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=cambia-esto-en-produccion-refresh-secret-32chars
JWT_REFRESH_EXPIRATION=7d

# ----- 2FA (TOTP) -----
TWOFA_ISSUER=SAP-ONAC

# ----- Seguridad -----
BCRYPT_ROUNDS=12
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_EXPIRATION_DAYS=90

# ----- Almacenamiento de archivos -----
# Windows: usa una ruta absoluta con barras normales o dobles invertidas
# Ej: UPLOAD_DIR=C:/tmp/sap-onac-uploads
# Ej: UPLOAD_DIR=D:/TRABAJO/DEV/sap-onac/uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ----- Logging -----
# Valores: trace | debug | info | warn | error
LOG_LEVEL=debug
